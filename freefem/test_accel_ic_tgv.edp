// Repro: does accel_ic_precon.idp break when a row has a HUGE (tgv-style,
// ~1e30) diagonal alongside NORMAL-magnitude off-diagonal entries (exactly
// FreeFEM's on()-constraint matrix structure, confirmed via
// test_check_symmetry.edp: PEC rows keep their original off-diagonals AND
// get a ~1e30 diagonal) -- while the earlier toy test had no such outlier.

int n = 5;
// Node 1 is the "PEC-like" huge-diagonal row, connected to 0,2,3 (fill-in
// pattern like the earlier toy: 0,2,3 have no original edges among themselves).
complex[int, int] Adense(n, n);
Adense = 0.0;
Adense(0,0) = 10.0 + 1.0i; Adense(1,1) = 1.0e30; Adense(2,2) = 8.0 + 0.5i;
Adense(3,3) = 6.0 - 0.5i;  Adense(4,4) = 5.0 + 0.0i;
Adense(1,0) = 2.0 - 1.0i;  Adense(0,1) = Adense(1,0);
Adense(1,2) = 1.5 + 0.5i;  Adense(2,1) = Adense(1,2);
Adense(1,3) = 1.0 + 1.0i;  Adense(3,1) = Adense(1,3);
Adense(3,4) = 0.7 - 0.2i;  Adense(4,3) = Adense(3,4);

int[int] rows = [0,1,2,3,4, 1,0,1,2,1,3, 3,4];
int[int] cols = [0,1,2,3,4, 0,1,2,1,3,1, 4,3];
complex[int] vals(13);
vals[0]=Adense(0,0); vals[1]=Adense(1,1); vals[2]=Adense(2,2); vals[3]=Adense(3,3); vals[4]=Adense(4,4);
vals[5]=Adense(1,0); vals[6]=Adense(0,1);
vals[7]=Adense(1,2); vals[8]=Adense(2,1);
vals[9]=Adense(1,3); vals[10]=Adense(3,1);
vals[11]=Adense(3,4); vals[12]=Adense(4,3);

matrix<complex> Aloc = [rows, cols, vals];

complex[int] xtrue(n);
for (int i = 0; i < n; i++) xtrue[i] = 1.0 + 1i * (i - 2.0);
xtrue[1] = 0.0;  // the "constrained" DOF should end up ~0 regardless
complex[int] b(n);
b = Aloc * xtrue;

func complex[int] matvec(complex[int] & v) {
  complex[int] y = Aloc * v;
  return y;
}

matrix<complex> aicA = Aloc;
int aicN = n;
real aicAlpha = 1.0;
include "accel_ic_precon.idp"

cout << "aicDiag: ";
for (int i = 0; i < n; i++) cout << aicDiag[i] << " ";
cout << endl;

func complex[int] precon(complex[int] & v) {
  complex[int] z = accelICPrecon(v);
  return z;
}

int gmresN = n;
complex[int] gmresB(n);
gmresB = b;
complex[int] gmresX(n);
gmresX = 0.0;
real gmresRtol = 1e-10;
int gmresMaxIt = 30;
int gmresRestart = 10;
int gmresIterCount = 0;
real gmresRelRes = 1.0;
int gmresConverged = 0;

include "gmres_precon.idp"

cout << "iters=" << gmresIterCount << " relRes=" << gmresRelRes << " converged=" << gmresConverged << endl;
complex[int] err(n);
err = gmresX;
err -= xtrue;
cout << "x = " << gmresX[0] << " " << gmresX[1] << " " << gmresX[2] << " " << gmresX[3] << " " << gmresX[4] << endl;
cout << "xtrue = " << xtrue[0] << " " << xtrue[1] << " " << xtrue[2] << " " << xtrue[3] << " " << xtrue[4] << endl;
cout << "||x-xtrue||=" << err.l2 << endl;
