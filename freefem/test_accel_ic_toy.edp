// Validate the accelerated-IC(0) preconditioner (accel_ic_precon.idp) on a
// small sparse complex-symmetric test matrix with a deliberate fill-in
// (node 0 is a hub connected to 1,2,3 with no original edges among 1,2,3 --
// eliminating row 0 first creates genuine fill at (1,2),(1,3),(2,3)), plus a
// separate fill-free 2x2 block (4,5) as a "should be exact" control.

int n = 6;
complex[int, int] Adense(n, n);
Adense = 0.0;
Adense(0,0) = 10.0 + 3.0i; Adense(1,1) = 8.0 + 2.0i; Adense(2,2) = 7.0 + 1.5i;
Adense(3,3) = 6.0 + 1.0i;  Adense(4,4) = 5.0 + 0.0i; Adense(5,5) = 5.0 + 0.0i;
Adense(0,1) = 2.0 + 1.0i;   Adense(1,0) = Adense(0,1);
Adense(0,2) = 1.5 - 0.5i;   Adense(2,0) = Adense(0,2);
Adense(0,3) = 1.0 - 1.0i;   Adense(3,0) = Adense(0,3);
Adense(4,5) = 1.0 + 0.2i;   Adense(5,4) = Adense(4,5);

// Build a sparse matrix<complex> only from the nonzero entries above (so the
// "pattern" used by accel_ic_precon.idp matches -- entries left at 0.0 above
// but not listed here would NOT be part of the pattern; since none of the
// zero entries were explicitly set as sparse nonzeros, this is consistent).
int[int] rows = [0,1,2,3,4,5, 0,1,0,2,0,3, 4,5];
int[int] cols = [0,1,2,3,4,5, 1,0,2,0,3,0, 5,4];
complex[int] vals(14);
vals[0] = Adense(0,0); vals[1] = Adense(1,1); vals[2] = Adense(2,2);
vals[3] = Adense(3,3); vals[4] = Adense(4,4); vals[5] = Adense(5,5);
vals[6] = Adense(0,1); vals[7] = Adense(1,0);
vals[8] = Adense(0,2); vals[9] = Adense(2,0);
vals[10] = Adense(0,3); vals[11] = Adense(3,0);
vals[12] = Adense(4,5); vals[13] = Adense(5,4);

matrix<complex> Aloc = [rows, cols, vals];

complex[int] xtrue(n);
for (int i = 0; i < n; i++) xtrue[i] = 1.0 + 1i * (i - 2.5);
complex[int] b(n);
b = Aloc * xtrue;

func complex[int] matvec(complex[int] & v) {
  complex[int] y = Aloc * v;
  return y;
}

// --- Test with acceleration factor ACCL = 1.0 (classic MILU / Gustafsson) ---
matrix<complex> aicA = Aloc;
int aicN = n;
real aicAlpha = 1.0;
include "accel_ic_precon.idp"

func complex[int] precon(complex[int] & v) {
  complex[int] z = accelICPrecon(v);
  return z;
}

int gmresN = n;
complex[int] gmresB(n);
gmresB = b;
complex[int] gmresX(n);
gmresX = 0.0;
real gmresRtol = 1e-10;
int gmresMaxIt = 50;
int gmresRestart = 10;
int gmresIterCount = 0;
real gmresRelRes = 1.0;
int gmresConverged = 0;

include "gmres_precon.idp"

cout << "ACCL=1.0: iters=" << gmresIterCount << " relRes=" << gmresRelRes << " converged=" << gmresConverged << endl;
complex[int] err(n);
err = gmresX;
err -= xtrue;
cout << "||x-xtrue||=" << err.l2 << " (xtrue.l2=" << xtrue.l2 << ")" << endl;

cout << "diag (should be real-dominant, finite): ";
for (int i = 0; i < n; i++) cout << aicDiag[i] << " ";
cout << endl;

int cocgN = n;
complex[int] cocgB(n);
cocgB = b;
complex[int] cocgX(n);
cocgX = 0.0;
real cocgRtol = 1e-10;
int cocgMaxIt = 50;
int cocgIterCount = 0;
real cocgRelRes = 1.0;
int cocgConverged = 0;

include "cocg_precon.idp"

cout << "COCG ACCL=1.0: iters=" << cocgIterCount << " relRes=" << cocgRelRes << " converged=" << cocgConverged << endl;
complex[int] errc(n);
errc = cocgX;
errc -= xtrue;
cout << "||x-xtrue||(cocg)=" << errc.l2 << endl;
